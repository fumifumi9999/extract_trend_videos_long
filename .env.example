# 環境変数のサンプル
# 事前に依存パッケージを入れてください: uv sync (または pip install -r requirements.txt)
#
# このファイルを .env にコピーして、値を自分のものに書き換えてください。
#   copy .env.example .env      (Windows cmd)
#   Copy-Item .env.example .env (PowerShell)
#
# .env は実際のAPIキーを含むため、絶対にコミット・共有しないでください。

# ---------------------------------------------------------------------------
# shorts_outlier.py 用
# ---------------------------------------------------------------------------
# YouTube Data API v3 のAPIキー (必須)
# 取得方法: https://console.cloud.google.com/ でプロジェクト作成
#   → 「YouTube Data API v3」を有効化 → 「認証情報」→ APIキーを作成
YOUTUBE_API_KEY=ここにAPIキーを貼り付け

# ---------------------------------------------------------------------------
# sheet_reader.py 用
# ---------------------------------------------------------------------------
# 読み取り対象スプレッドシートのURL (またはID) (必須)
SPREADSHEET_URL=https://docs.google.com/spreadsheets/d/ここにIDを貼り付け/edit

# 認証は下のどちらか一方を設定してください。

# [A] サービスアカウント (非公開シートも読める / 推奨)
#   1. Google Cloud で「Google Sheets API」を有効化
#   2. サービスアカウントを作成 → JSONキーをダウンロードしてこのフォルダに置く
#   3. スプレッドシートの「共有」で、JSON内の client_email
#      (xxx@yyy.iam.gserviceaccount.com) に閲覧者権限を付与
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# [B] APIキー (「リンクを知っている全員が閲覧可」のシートのみ読める)
#   上の YOUTUBE_API_KEY は流用されません。使う場合は明示的に設定してください。
# GOOGLE_API_KEY=ここにAPIキーを貼り付け

# ---------------------------------------------------------------------------
# mail_sender.py 用
# ---------------------------------------------------------------------------
# 送信元Gmailアドレス
GMAIL_ADDRESS=あなたのアドレス@gmail.com

# アプリパスワード16桁
#   1. https://myaccount.google.com/security で2段階認証プロセスをONにする
#   2. https://myaccount.google.com/apppasswords でアプリ名を入力して作成
#   3. 表示された16桁をここに貼り付ける (スペース込みでも可)
# ※通常のGoogleアカウントのパスワードでは送信できません
GMAIL_APP_PASSWORD=ここにアプリパスワードを貼り付け

# 既定の宛先 (send(to=...) を省略したときに使われる。カンマ区切りで複数可)
MAIL_TO=宛先@example.com
