# APIキーを含む実ファイル (.env.example のみコミットする)
.env

# サービスアカウントの秘密鍵
spreadsheet_key/*
*-credentials.json

# 出力CSV / メール本文のプレビュー
shorts_outliers_*.csv
long_videos_*.csv
report_preview.html

# タスクスケジューラ実行時のログ (run_daily.cmd が日付ごとに出力する)
logs/


__pycache__/
*.pyc

# 仮想環境 (uv は通常キャッシュ内の環境を使うため作られない)
.venv/
# shorts_outlier.py.lock は再現性のためコミットする
